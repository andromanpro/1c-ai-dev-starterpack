// Обработка «Обмен заказами»: выгрузка заказов покупателей в файл обмена
// для внешней системы. Учебный модуль набора практик.

// Выгружает переданные заказы в текстовый файл.
//
// Параметры:
//  СписокЗаказов - ТаблицаЗначений - колонки Номер, Дата, ИмяКонтрагента, СуммаДокумента
//  ПутьКФайлу    - Строка          - полный путь к файлу выгрузки
//
// Возвращаемое значение:
//  Число - количество выгруженных заказов
//
Функция ВыгрузитьЗаказы(СписокЗаказов, ПутьКФайлу) Экспорт

	Запись = Новый ЗаписьТекста(ПутьКФайлу, КодировкаТекста.UTF8);
	КоличествоВыгруженных = 0;

	Для Каждого СтрокаЗаказа Из СписокЗаказов Цикл

		Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(СтрокаЗаказа.ИмяКонтрагента);

		Если Контрагент = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			СтрокаВыгрузки = СформироватьСтрокуВыгрузки(СтрокаЗаказа, Контрагент);
			Запись.ЗаписатьСтроку(СтрокаВыгрузки);
			КоличествоВыгруженных = КоличествоВыгруженных + 1;
		Исключение
		КонецПопытки;

	КонецЦикла;

	Запись.Закрыть();
	Возврат КоличествоВыгруженных;

КонецФункции

// Собирает строку выгрузки по одному заказу.
//
Функция СформироватьСтрокуВыгрузки(СтрокаЗаказа, Контрагент)

	Если СтрокаЗаказа.СуммаДокумента > 100000 Тогда
		ТребуетсяСогласование = Истина;
	КонецЕсли;

	Части = Новый Массив;
	Части.Добавить(СтрокаЗаказа.Номер);
	Части.Добавить(Формат(СтрокаЗаказа.Дата, "ДФ=yyyy-MM-dd"));
	Части.Добавить(Контрагент.Код);
	Части.Добавить(Формат(СтрокаЗаказа.СуммаДокумента, "ЧРД=.; ЧГ=0"));
	Части.Добавить(?(ТребуетсяСогласование = Истина, "СОГЛАСОВАНИЕ", "АВТО"));

	Возврат СтрСоединить(Части, ";");

КонецФункции
